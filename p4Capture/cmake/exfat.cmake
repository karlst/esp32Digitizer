# Prepare a project-local FatFs component before ESP-IDF discovers components.
# The installed SDK is read-only input. All generated sources stay in the
# selected build directory; every consumer uses the SAME ff.h/ffconf.h pair.
# This matters because exFAT changes FIL/FSIZE_t layouts, not just mount logic.
file(TO_CMAKE_PATH "$ENV{IDF_PATH}" p4IdfPath)
include("${p4IdfPath}/tools/cmake/version.cmake")
if(NOT "${IDF_VERSION_MAJOR}.${IDF_VERSION_MINOR}.${IDF_VERSION_PATCH}" STREQUAL "5.5.6")
    message(FATAL_ERROR "P4 exFAT configuration is reviewed for ESP-IDF 5.5.6; review it before changing SDK versions.")
endif()

# Copy the bundled implementation, preserving its source/license notices and
# build metadata. Tests are SDK development assets, not firmware dependencies.
set(p4FatfsSource "${p4IdfPath}/components/fatfs")
set(p4FatfsRoot "${CMAKE_BINARY_DIR}/p4-components")
set(p4FatfsComponent "${p4FatfsRoot}/fatfs")
file(COPY "${p4FatfsSource}" DESTINATION "${p4FatfsRoot}"
    PATTERN "test_apps" EXCLUDE PATTERN "host_test" EXCLUDE
    PATTERN "test_fatfsgen" EXCLUDE PATTERN "__pycache__" EXCLUDE)

# Override the configuration at its end, after the SDK's Kconfig-derived
# settings. Existing sdkconfig.sd files therefore gain support without a
# menuconfig reset. Heap-backed filename buffers avoid large stack buffers.
# exFAT requires LFN internally even though our own file names are short.
file(READ "${p4FatfsSource}/src/ffconf.h" p4FatfsConfig)
set(p4FatfsEnd "#endif /* _FFCONF_DEFINED */")
string(FIND "${p4FatfsConfig}" "${p4FatfsEnd}" p4FatfsEndPosition)
if(p4FatfsEndPosition LESS 0 OR NOT p4FatfsConfig MATCHES "#define FFCONF_DEF[ \t]+80286")
    message(FATAL_ERROR "Unexpected FatFs configuration layout; refusing an unchecked exFAT override.")
endif()
set(p4FatfsOverrides [=[
/* P4 recording project: exFAT plus FAT16/FAT32, heap-backed Unicode names.
 * Generated by p4Capture/cmake/exfat.cmake; do not edit this build copy.
 * These settings intentionally override saved FATFS_LFN_* Kconfig choices.
 */
#undef FF_FS_EXFAT
#define FF_FS_EXFAT 1
#undef FF_USE_LFN
#define FF_USE_LFN 3
#undef FF_MAX_LFN
#define FF_MAX_LFN 255
/* Kconfig omits disabled boolean macros. exFAT also uses FF_USE_LABEL in
 * a C expression, where an undefined identifier is not implicitly zero.
 * Preserve the selected behavior while making both cases numeric.
 */
#undef FF_USE_LABEL
#ifdef CONFIG_FATFS_USE_LABEL
#define FF_USE_LABEL CONFIG_FATFS_USE_LABEL
#else
#define FF_USE_LABEL 0
#endif
]=])
string(REPLACE "${p4FatfsEnd}" "${p4FatfsOverrides}\n${p4FatfsEnd}"
    p4FatfsConfig "${p4FatfsConfig}")
file(WRITE "${p4FatfsComponent}/src/ffconf.h" "${p4FatfsConfig}")
list(APPEND EXTRA_COMPONENT_DIRS "${p4FatfsComponent}")
message(STATUS "P4 FatFs: exFAT enabled; heap filename buffers; SDK installation unchanged")
