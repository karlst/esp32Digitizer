# Use together with sdkconfig.defaults; a separate sdkconfig.sd avoids changing
# the saved memory-only build configuration.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_SPEED_200M=y
