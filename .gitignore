# PlatformIO build products
**/.pio/

# Per-project VS Code generated settings
**/.vscode/

# Python junk, if any tools/scripts are added later
__pycache__/
*.pyc

# OS junk
.DS_Store
Thumbs.db

# Preserve firmware backups locally, but don't put large binary images in Git
backups/*.bin

# Ignore this entire folder and contents
/fpos/
# Local research extracts and scratch images.
/tmp/

# Generated plots, capture sessions and scratch analysis. Curated raw evidence
# is intentionally kept under docs/evidence instead. These rules do not untrack
# files already committed; Karl reviews tracked files before committing.
/work/
